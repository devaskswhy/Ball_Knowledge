# API-Football key (v3.football.api-sports.io) - free plan, 100 requests/day.
# Either name works; the code checks both.
API_SPORTS_KEY=your_key_here
# API_FOOTBALL_KEY=your_key_here

# Claude API key for /ai/preview, /ai/title_race, /ai/ask.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_key_here

# Optional locally - defaults to a SQLite file at the repo root if unset.
# In production (Render), this is wired automatically from the attached
# Postgres database; see render.yaml.
# DATABASE_URL=postgresql://user:pass@localhost:5432/ballknowledge
